# Copy to `.env.local` to point the panel at a live machine. Holds NO credential.
#
# Without these the panel runs on the deterministic demo world, which is the
# right default: a fresh clone starts and every check passes with no machine
# running and no money spendable.
#
# The OpenRouter key does NOT go here. It lives in
# `services/concept-portfolio/.env`, written by the panel's own key card
# (تنظیمات) with 0600 permissions — this file is read by the Next process, and
# the panel must never be able to read the key it asks you to paste.

# Where the machine is. Setting this alone switches the panel to live data.
DROP_MACHINE_BASE_URL=http://127.0.0.1:8000

# Which session to open when no session has been started from the panel.
# Optional: leave it out and start one with «شروع کانسپت جدید», which sets a
# cookie that overrides this.
# DROP_MACHINE_SESSION_ID=

# Exposes the key card at /studio/settings. DEV ONLY — the panel has no
# authentication, so this must never be set on anything reachable.
DROP_PROVIDER_KEY_ADMIN=1

# Writes are off unless this is set, in production. Locally, dev implies on.
# Never set it on a deployment without authentication in front of /api/machine:
# the write routes spend the owner's model budget and the proxy is a transport
# boundary, not an authorization one.
# DROP_MACHINE_WRITES=1

# Caps on spending, all optional. Defaults shown.
# DROP_MACHINE_MAX_ROUNDS=6
